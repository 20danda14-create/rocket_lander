<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, shrink-to-fit=no">
    <title>Roket Yakalama (Mobil Sürüm)</title>
    <style>
        /* Mobil tarayıcılarda kaydırma, büyütme ve seçmeyi tamamen kapatıyoruz */
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
            touch-action: none;
            margin: 0;
            padding: 0;
        }
        html, body {
            background-color: #0d1b2a;
            font-family: -apple-system, BlinkMacSystemFont, sans-serif;
            overflow: hidden;
            width: 100vw;
            height: 100vh;
            position: relative;
        }
        #gameCanvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            display: block;
            z-index: 1;
        }
        #ui-overlay {
            position: absolute;
            top: 20px;
            left: 15px;
            right: 15px;
            display: flex;
            justify-content: space-between;
            font-size: 14px;
            pointer-events: none;
            z-index: 10;
        }
        .stat-box {
            background: rgba(11, 19, 43, 0.95);
            padding: 8px 12px;
            border-radius: 8px;
            border: 1px solid #3a506b;
            color: #fff;
            font-weight: bold;
        }
        #msg-screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: #0b132b;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 30px;
            z-index: 9999; 
        }
        #msg-title {
            font-size: 28px;
            margin-bottom: 15px;
            font-weight: bold;
            color: #06d6a0;
        }
        #msg-desc {
            font-size: 16px;
            margin-bottom: 35px;
            color: #cbd5e1;
            max-width: 290px;
            line-height: 1.5;
        }
        #btn-start {
            padding: 18px 60px;
            background: #06d6a0;
            border: none;
            border-radius: 30px;
            font-size: 20px;
            font-weight: bold;
            color: #0b132b;
            box-shadow: 0 6px #049f76;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <canvas id="gameCanvas"></canvas>
    
    <div id="ui-overlay">
        <div class="stat-box">Hız: <span id="speed-val">0</span> m/s</div>
        <div class="stat-box">Yakıt: <span id="fuel-val">100</span>%</div>
        <div class="stat-box">Skor: <span id="score-val">0</span></div>
    </div>

    <div id="msg-screen">
        <div id="msg-title">Dron Gemisi İnişi</div>
        <div id="msg-desc">Ekranın SOL tarafına basarak halatı sola, SAĞ tarafına basarak sağa çek! İniş motoru otomatik açılır.</div>
        <button id="btn-start">BAŞLA</button>
    </div>

    <script>
        (function() {
            const canvas = document.getElementById('gameCanvas');
            const ctx = canvas.getContext('2d');

            let score = 0;
            let gameState = 'START'; 
            
            const GRAVITY = 0.08;
            const THRUST_ACCEL = 0.22;
            const SAFE_SPEED = 2.5;

            let rocket = { x: 0, y: 30, vx: 0, vy: 0, width: 14, height: 45, fuel: 100, isThrusting: false };
            let platform = { x: 0, y: 0, radius: 70, netWidth: 46, netX: 0 };

            let touchSide = null; // 'LEFT', 'RIGHT' veya null

            const btnStart = document.getElementById('btn-start');
            const msgScreen = document.getElementById('msg-screen');
            const msgTitle = document.getElementById('msg-title');
            const msgDesc = document.getElementById('msg-desc');

            const speedVal = document.getElementById('speed-val');
            const fuelVal = document.getElementById('fuel-val');
            const scoreVal = document.getElementById('score-val');

            function resizeGame() {
                const w = window.innerWidth;
                const h = window.innerHeight;
                canvas.width = w;
                canvas.height = h;
                
                platform.y = h - 60;
                platform.x = w / 2;
                
                if (gameState === 'START') {
                    platform.netX = platform.x;
                    rocket.x = platform.x;
                    rocket.y = 40;
                }
            }

            window.addEventListener('resize', resizeGame);
            window.addEventListener('orientationchange', resizeGame);
            resizeGame();

            function initGame() {
                resizeGame();
                rocket.x = Math.random() * (canvas.width - 60) + 30;
                rocket.y = 40;
                rocket.vx = (Math.random() - 0.5) * 2.5;
                rocket.vy = 0.5;
                rocket.fuel = 100;
                rocket.isThrusting = false;
                touchSide = null;
                
                gameState = 'PLAYING';
                msgScreen.style.display = 'none';
            }

            // Giriş Ekranı Buton Tetikleyicisi
            btnStart.addEventListener('touchstart', function(e) {
                e.preventDefault();
                initGame();
            }, {passive: false});
            btnStart.addEventListener('click', function(e) {
                e.preventDefault();
                initGame();
            });

            // Ekranın Sol/Sağ Tarafına Dokunma Kontrolleri
            window.addEventListener('touchstart', function(e) {
                if (gameState !== 'PLAYING') return;
                e.preventDefault();
                
                const touchX = e.touches[0].clientX;
                if (touchX < window.innerWidth / 2) {
                    touchSide = 'LEFT';
                } else {
                    touchSide = 'RIGHT';
                }
            }, {passive: false});

            window.addEventListener('touchmove', function(e) {
                if (gameState !== 'PLAYING') return;
                e.preventDefault();
                
                const touchX = e.touches[0].clientX;
                if (touchX < window.innerWidth / 2) {
                    touchSide = 'LEFT';
                } else {
                    touchSide = 'RIGHT';
                }
            }, {passive: false});

            window.addEventListener('touchend', function(e) {
                if (gameState !== 'PLAYING') return;
                e.preventDefault();
                if (e.touches.length === 0) {
                    touchSide = null;
                }
            }, {passive: false});

            // Masaüstü Test Desteği (Fare ile tıklama)
            window.addEventListener('mousedown', function(e) {
                if (gameState !== 'PLAYING') return;
                if (e.clientX < window.innerWidth / 2) touchSide = 'LEFT';
                else touchSide = 'RIGHT';
            });
            window.addEventListener('mouseup', function() {
                touchSide = null;
            });


            function update() {
                if (gameState !== 'PLAYING') return;

                // Halat Hareketi
                if (touchSide === 'LEFT') platform.netX -= 5;
                if (touchSide === 'RIGHT') platform.netX += 5;
                
                const maxOffset = platform.radius - 15;
                if (platform.netX < platform.x - maxOffset) platform.netX = platform.x - maxOffset;
                if (platform.netX > platform.x + maxOffset) platform.netX = platform.x + maxOffset;

                // Yerçekimi
                rocket.vy += GRAVITY;
                
                // Otomatik Ters İtiş (Yere yaklaşırken hız yüksekse motoru açar)
                const distanceToNet = (platform.y - 30) - (rocket.y + rocket.height);
                if (distanceToNet < 160 && rocket.vy > SAFE_SPEED && rocket.fuel > 0) {
                    rocket.isThrusting = true;
                    rocket.vy -= THRUST_ACCEL;
                    rocket.fuel -= 0.6;
                } else {
                    rocket.isThrusting = false;
                }
                if (rocket.fuel < 0) rocket.fuel = 0;

                rocket.x += rocket.vx;
                rocket.y += rocket.vy;

                // Duvarlardan Sekme
                if (rocket.x < rocket.width || rocket.x > canvas.width - rocket.width) {
                    rocket.vx *= -1;
                }

                // UI Güncelleme
                if (speedVal) speedVal.innerText = Math.abs(rocket.vy * 5).toFixed(1);
                if (fuelVal) fuelVal.innerText = Math.ceil(rocket.fuel);
                
                if (speedVal) {
                    if (Math.abs(rocket.vy) <= SAFE_SPEED) speedVal.style.color = '#06d6a0';
                    else speedVal.style.color = '#e63946';
                }

                // Yakalama Kontrolü
                const netTopY = platform.y - 30;
                if (rocket.y + rocket.height >= netTopY && rocket.y <= platform.y) {
                    const halfNet = platform.netWidth / 2;
                    if (rocket.x >= platform.netX - halfNet && rocket.x <= platform.netX + halfNet) {
                        if (Math.abs(rocket.vy) <= SAFE_SPEED) {
                            gameState = 'SUCCESS';
                            score += 10;
                            if (scoreVal) scoreVal.innerText = score;
                            endGame("MÜKEMMEL!", "Halatlar roketi yakaladı. +10 Puan!", "#06d6a0");
                        } else {
                            gameState = 'CRASH';
                            endGame("ÇOK HIZLI!", "Hız yüksek olduğu için roket patladı.", "#e63946");
                        }
                    }
                }

                // Denize Düşme Kontrolü
                if (rocket.y + rocket.height >= platform.y + 10) {
                    gameState = 'CRASH';
                    endGame("DENİZE DÜŞTÜ!", "Platformu ıskaladın.", "#e63946");
                }
            }

            function endGame(title, desc, color) {
                if (msgTitle) { msgTitle.innerText = title; msgTitle.style.color = color; }
                if (msgDesc) msgDesc.innerText = desc;
                if (btnStart) btnStart.innerText = "YENİDEN DENE";
                if (msgScreen) msgScreen.style.display = 'flex';
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                // Gökyüzü
                ctx.fillStyle = '#0b132b';
                ctx.fillRect(0, 0, canvas.width, platform.y);

                // Deniz
                ctx.fillStyle = '#1d3557';
                ctx.fillRect(0, platform.y, canvas.width, canvas.height - platform.y);

                // Dron Gemi Platformu (Görsel perspektif)
                ctx.save();
                ctx.translate(platform.x, platform.y);
                ctx.scale(1, 0.3);
                ctx.beginPath();
                ctx.arc(0, 0, platform.radius, 0, Math.PI * 2);
                ctx.fillStyle = '#4a5759';
                ctx.fill();
                ctx.lineWidth = 4;
                ctx.strokeStyle = '#f1faee';
                ctx.stroke();
                ctx.restore();

                // Yakalama Halat Direkleri ve Net
                const pY = platform.y;
                const nX = platform.netX;
                const nW = platform.netWidth;
                const poleH = 40;

                ctx.lineWidth = 3;
                ctx.strokeStyle = '#8d99ae';
                ctx.beginPath(); ctx.moveTo(nX - nW/2, pY - 10); ctx.lineTo(nX - nW/2, pY - poleH); ctx.stroke();
                ctx.beginPath(); ctx.moveTo(nX + nW/2, pY - 10); ctx.lineTo(nX + nW/2, pY - poleH); ctx.stroke();
                
                ctx.lineWidth = 2;
                ctx.strokeStyle = '#d8f3dc';
                for (let i = 0; i < 3; i++) {
                    let hY = (pY - poleH + 8) + (i * 8);
                    ctx.beginPath(); ctx.moveTo(nX - nW/2, hY); ctx.lineTo(nX + nW/2, hY); ctx.stroke();
                }

                // Roket Çizimi
                if (gameState === 'PLAYING' || gameState === 'SUCCESS') {
                    ctx.save();
                    ctx.translate(rocket.x, rocket.y);

                    if (rocket.isThrusting && rocket.fuel > 0) {
                        ctx.fillStyle = '#ffb703';
                        ctx.beginPath();
                        ctx.moveTo(-rocket.width/2, rocket.height);
                        ctx.lineTo(0, rocket.height + Math.random() * 20 + 10);
                        ctx.lineTo(rocket.width/2, rocket.height);
                        ctx.closePath();
                        ctx.fill();
                    }

                    ctx.fillStyle = '#e5e5e5';
                    ctx.fillRect(-rocket.width/2, 0, rocket.width, rocket.height - 10);
                    
                    ctx.fillStyle = '#118ab2';
                    ctx.beginPath();
                    ctx.moveTo(-rocket.width/2, 0); ctx.lineTo(0, -12); ctx.lineTo(rocket.width/2, 0);
                    ctx.closePath(); ctx.fill();

                    ctx.fillStyle = '#f77f00';
                    ctx.fillRect(-rocket.width/2 - 4, rocket.height - 18, 4, 8);
                    ctx.fillRect(rocket.width/2, rocket.height - 18, 4, 8);

                    ctx.restore();
                }
            }

            function gameLoop() {
                update();
                draw();
                requestAnimationFrame(gameLoop);
            }

            requestAnimationFrame(gameLoop);
        })();
    </script>
</body>
</html>
