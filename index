<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Deniz Üstü Roket Yakalama Simülatörü</title>
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            touch-action: none;
            margin: 0;
            padding: 0;
        }
        body {
            background-color: #0d1b2a;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            overflow: hidden;
            width: 100vw;
            height: 100vh;
            position: relative;
        }
        #gameCanvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: calc(100vh - 160px);
            display: block;
            z-index: 1;
        }
        #ui-overlay {
            position: absolute;
            top: 15px;
            left: 15px;
            right: 15px;
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            pointer-events: none;
            z-index: 5;
        }
        .stat-box {
            background: rgba(11, 19, 43, 0.9);
            padding: 6px 10px;
            border-radius: 6px;
            border: 1px solid #3a506b;
            color: #fff;
            font-weight: bold;
        }
        #controls {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100vw;
            height: 160px;
            background: #1c2541;
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding: 12px;
            z-index: 10;
            border-top: 4px solid #3a506b;
        }
        .row {
            display: flex;
            gap: 8px;
            flex: 1;
        }
        .btn {
            flex: 1;
            background: #3a506b;
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: bold;
            box-shadow: 0 4px #243346;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }
        .btn:active {
            background: #5bc0be;
            box-shadow: 0 2px #243346;
            transform: translateY(2px);
        }
        #btn-thrust {
            background: #e63946;
            box-shadow: 0 4px #b51726;
            font-size: 18px;
        }
        /* Hatanın kaynağı burasıydı: z-index değerini en üste çekerek butonun tıklanmasını garanti ediyoruz */
        #msg-screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: #0b132b;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 20px;
            z-index: 9999; 
        }
        #msg-title {
            font-size: 26px;
            margin-bottom: 12px;
            font-weight: bold;
            color: #06d6a0;
        }
        #msg-desc {
            font-size: 15px;
            margin-bottom: 35px;
            color: #cbd5e1;
            max-width: 280px;
            line-height: 1.4;
        }
        #btn-restart {
            padding: 16px 50px;
            background: #06d6a0;
            border: none;
            border-radius: 25px;
            font-size: 18px;
            font-weight: bold;
            color: #0b132b;
            box-shadow: 0 4px #049f76;
            cursor: pointer;
            display: block;
        }
    </style>
</head>
<body>

    <canvas id="gameCanvas"></canvas>
    
    <div id="ui-overlay">
        <div class="stat-box">Hız: <span id="speed-val">0</span> m/s</div>
        <div class="stat-box">Yakıt: <span id="fuel-val">100</span>%</div>
        <div class="stat-box">Skor: <span id="score-val">0</span></div>
    </div>

    <div id="msg-screen">
        <div id="msg-title">Dron Gemisi İnişi</div>
        <div id="msg-desc">Halatları roketin rotasına çek ve ters itişle yavaşla! İniş hızı yeşil olmalı.</div>
        <button id="btn-restart">OYUNA BAŞLA</button>
    </div>

    <div id="controls">
        <div class="row">
            <button class="btn" id="btn-thrust">TERS İTİŞ (THRUST)</button>
        </div>
        <div class="row">
            <button class="btn" id="btn-left">◀ HALAT SOL</button>
            <button class="btn" id="btn-right">HALAT SAĞ ▶</button>
        </div>
    </div>

    <script>
        (function() {
            const canvas = document.getElementById('gameCanvas');
            const ctx = canvas.getContext('2d');

            let score = 0;
            let gameState = 'START'; 
            
            const GRAVITY = 0.12;
            const THRUST_ACCEL = 0.32;
            const SAFE_SPEED = 2.5;

            let rocket = { x: 100, y: 30, vx: 0, vy: 0, width: 14, height: 45, fuel: 100, isThrusting: false };
            let platform = { x: 100, y: 200, radius: 65, netWidth: 42, netX: 100 };

            let moveLeft = false;
            let moveRight = false;

            const btnThrust = document.getElementById('btn-thrust');
            const btnLeft = document.getElementById('btn-left');
            const btnRight = document.getElementById('btn-right');
            const btnRestart = document.getElementById('btn-restart');
            const msgScreen = document.getElementById('msg-screen');
            const msgTitle = document.getElementById('msg-title');
            const msgDesc = document.getElementById('msg-desc');

            const speedVal = document.getElementById('speed-val');
            const fuelVal = document.getElementById('fuel-val');
            const scoreVal = document.getElementById('score-val');

            function resizeGame() {
                const w = window.innerWidth > 0 ? window.innerWidth : screen.width;
                const h = window.innerHeight > 0 ? window.innerHeight : screen.height;

                canvas.width = w;
                canvas.height = h - 160; 
                
                platform.y = canvas.height - 30;
                platform.x = w / 2;
                
                if (gameState === 'START') {
                    platform.netX = platform.x;
                    rocket.x = platform.x;
                    rocket.y = 40;
                }
            }

            // İlk yerleşimi anında kur
            resizeGame();
            window.addEventListener('resize', resizeGame);
            window.addEventListener('orientationchange', resizeGame);

            function initGame() {
                resizeGame();
                rocket.x = Math.random() * (canvas.width - 60) + 30;
                rocket.y = 30;
                rocket.vx = (Math.random() - 0.5) * 2;
                rocket.vy = 0.5;
                rocket.fuel = 100;
                rocket.isThrusting = false;
                
                gameState = 'PLAYING';
                msgScreen.style.display = 'none';
            }

            // Buton Olayları (Hem Masaüstü Hem Mobil click/touch Korumalı)
            btnRestart.addEventListener('click', function(e) {
                e.preventDefault();
                initGame();
            });
            btnRestart.addEventListener('touchstart', function(e) {
                e.preventDefault();
                initGame();
            }, {passive: false});

            btnThrust.addEventListener('touchstart', function(e) { e.preventDefault(); rocket.isThrusting = true; }, {passive: false});
            btnThrust.addEventListener('touchend', function(e) { e.preventDefault(); rocket.isThrusting = false; }, {passive: false});
            btnThrust.addEventListener('mousedown', function() { rocket.isThrusting = true; });
            btnThrust.addEventListener('mouseup', function() { rocket.isThrusting = false; });

            btnLeft.addEventListener('touchstart', function(e) { e.preventDefault(); moveLeft = true; }, {passive: false});
            btnLeft.addEventListener('touchend', function(e) { e.preventDefault(); moveLeft = false; }, {passive: false});
            btnLeft.addEventListener('mousedown', function() { moveLeft = true; });
            btnLeft.addEventListener('mouseup', function() { moveLeft = false; });

            btnRight.addEventListener('touchstart', function(e) { e.preventDefault(); moveRight = true; }, {passive: false});
            btnRight.addEventListener('touchend', function(e) { e.preventDefault(); moveRight = false; }, {passive: false});
            btnRight.addEventListener('mousedown', function() { moveRight = true; });
            btnRight.addEventListener('mouseup', function() { moveRight = false; });

            function update() {
                if (gameState !== 'PLAYING') return;

                if (moveLeft) platform.netX -= 4;
                if (moveRight) platform.netX += 4;
                
                const maxOffset = platform.radius - 15;
                if (platform.netX < platform.x - maxOffset) platform.netX = platform.x - maxOffset;
                if (platform.netX > platform.x + maxOffset) platform.netX = platform.x + maxOffset;

                rocket.vy += GRAVITY;
                
                if (rocket.isThrusting && rocket.fuel > 0) {
                    rocket.vy -= THRUST_ACCEL;
                    rocket.fuel -= 0.5;
                    if (rocket.fuel < 0) rocket.fuel = 0;
                }

                rocket.x += rocket.vx;
                rocket.y += rocket.vy;

                if (rocket.x < 0 || rocket.x > canvas.width) {
                    rocket.vx *= -1;
                }

                if (speedVal) speedVal.innerText = Math.abs(rocket.vy * 5).toFixed(1);
                if (fuelVal) fuelVal.innerText = Math.ceil(rocket.fuel);
                
                if (speedVal) {
                    if (Math.abs(rocket.vy) <= SAFE_SPEED) {
                        speedVal.style.color = '#06d6a0';
                    } else {
                        speedVal.style.color = '#e63946';
                    }
                }

                const netTopY = platform.y - 30; 
                
                if (rocket.y + rocket.height >= netTopY && rocket.y <= platform.y) {
                    const halfNet = platform.netWidth / 2;
                    if (rocket.x >= platform.netX - halfNet && rocket.x <= platform.netX + halfNet) {
                        if (Math.abs(rocket.vy) <= SAFE_SPEED) {
                            gameState = 'SUCCESS';
                            score += 10;
                            if (scoreVal) scoreVal.innerText = score;
                            endGame("MÜKEMMEL YAKALAMA!", "Halatlar roketi güvenle kavradı. +10 Puan!", "#06d6a0");
                        } else {
                            gameState = 'CRASH';
                            endGame("ÇOK HIZLI GELDİN!", "Hızın yüksek olduğu için halatlar koptu ve roket patladı.", "#e63946");
                        }
                    }
                }

                if (rocket.y + rocket.height >= platform.y + 10) {
                    gameState = 'CRASH';
                    endGame("ÇAKILMA!", "Platformu veya halatları ıskalayarak denize düştün.", "#e63946");
                }
            }

            function endGame(title, desc, color) {
                if (msgTitle) { msgTitle.innerText = title; msgTitle.style.color = color; }
                if (msgDesc) msgDesc.innerText = desc;
                if (btnRestart) btnRestart.innerText = "YENİDEN DENE";
                if (msgScreen) msgScreen.style.display = 'flex';
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                ctx.fillStyle = '#0b132b';
                ctx.fillRect(0, 0, canvas.width, Math.max(0, platform.y));

                ctx.fillStyle = '#1d3557';
                ctx.fillRect(0, platform.y, canvas.width, Math.max(0, canvas.height - platform.y));

                ctx.save();
                ctx.translate(platform.x, platform.y);
                ctx.scale(1, 0.3); 
                ctx.beginPath();
                ctx.arc(0, 0, platform.radius, 0, Math.PI * 2);
                ctx.fillStyle = '#4a5759';
                ctx.fill();
                ctx.lineWidth = 4;
                ctx.strokeStyle = '#f1faee';
                ctx.stroke();
                ctx.restore();

                const pY = platform.y;
                const nX = platform.netX;
                const nW = platform.netWidth;
                const poleH = 40; 

                ctx.lineWidth = 3;
                ctx.strokeStyle = '#8d99ae';
                ctx.beginPath(); ctx.moveTo(nX - nW/2, pY - 10); ctx.lineTo(nX - nW/2, pY - poleH); ctx.stroke();
                ctx.beginPath(); ctx.moveTo(nX + nW/2, pY - 10); ctx.lineTo(nX + nW/2, pY - poleH); ctx.stroke();
                
                ctx.lineWidth = 2;
                ctx.strokeStyle = '#d8f3dc';
                for (let i = 0; i < 3; i++) {
                    let hY = (pY - poleH + 8) + (i * 8);
                    ctx.beginPath(); ctx.moveTo(nX - nW/2, hY); ctx.lineTo(nX + nW/2, hY); ctx.stroke();
                }

                if (gameState === 'PLAYING' || gameState === 'SUCCESS') {
                    ctx.save();
                    ctx.translate(rocket.x, rocket.y);

                    if (rocket.isThrusting && rocket.fuel > 0 && gameState === 'PLAYING') {
                        ctx.fillStyle = '#ffb703';
                        ctx.beginPath();
                        ctx.moveTo(-rocket.width/2, rocket.height);
                        ctx.lineTo(0, rocket.height + Math.random() * 25 + 10);
                        ctx.lineTo(rocket.width/2, rocket.height);
                        ctx.closePath();
                        ctx.fill();
                    }

                    ctx.fillStyle = '#e5e5e5';
                    ctx.fillRect(-rocket.width/2, 0, rocket.width, rocket.height - 10);
                    
                    ctx.fillStyle = '#118ab2';
                    ctx.beginPath();
                    ctx.moveTo(-rocket.width/2, 0); ctx.lineTo(0, -12); ctx.lineTo(rocket.width/2, 0);
                    ctx.closePath(); ctx.fill();

                    ctx.fillStyle = '#f77f00';
                    ctx.fillRect(-rocket.width/2 - 4, rocket.height - 18, 4, 8);
                    ctx.fillRect(rocket.width/2, rocket.height - 18, 4, 8);

                    ctx.restore();
                }
            }

            function gameLoop() {
                update();
                draw();
                requestAnimationFrame(gameLoop);
            }

            requestAnimationFrame(gameLoop);
        })();
    </script>
</body>
</html>
