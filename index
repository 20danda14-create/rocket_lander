<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Mobil Roket</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
        }
        body {
            background-color: #0d1b2a;
            font-family: sans-serif;
            overflow: hidden;
            width: 100vw;
            height: 100vh;
        }
        #gameCanvas {
            display: block;
            background: #0b132b;
            width: 100vw;
            height: calc(100vh - 120px);
        }
        #controls {
            display: flex;
            width: 100vw;
            height: 120px;
            background: #1c2541;
            padding: 10px;
            gap: 10px;
        }
        .move-btn {
            flex: 1;
            background: #3a506b;
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 20px;
            font-weight: bold;
        }
        .move-btn:active {
            background: #5bc0be;
        }
        #msg-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: #0b132b;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: white;
            padding: 20px;
            text-align: center;
        }
        #msg-title {
            font-size: 24px;
            color: #06d6a0;
            margin-bottom: 10px;
        }
        #msg-desc {
            font-size: 14px;
            color: #cbd5e1;
            margin-bottom: 30px;
        }
        #btn-start {
            padding: 15px 40px;
            background: #06d6a0;
            color: #0b132b;
            border: none;
            border-radius: 20px;
            font-size: 18px;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <div id="msg-screen">
        <div id="msg-title">Dron Gemisi İnişi</div>
        <div id="msg-desc">Alttaki büyük butonlarla halatı sağa sola kaydır. İniş motoru otomatik çalışır.</div>
        <button id="btn-start" onclick="startGame()">OYUNA BAŞLA</button>
    </div>

    <canvas id="gameCanvas"></canvas>

    <div id="controls">
        <button class="move-btn" id="left-btn">◀ SOL</button>
        <button class="move-btn" id="right-btn">SAĞ ▶</button>
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        let gameState = 'START';
        let rocket = { x: 0, y: 30, vx: 0, vy: 0, width: 12, height: 40, isThrusting: false };
        let platform = { x: 0, y: 0, radius: 60, netWidth: 40, netX: 0 };
        
        let moveLeft = false;
        let moveRight = false;

        function initDimensions() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight - 120;
            platform.y = canvas.height - 20;
            platform.x = canvas.width / 2;
            if (gameState === 'START') {
                platform.netX = platform.x;
            }
        }
        
        window.addEventListener('resize', initDimensions);
        initDimensions();

        function startGame() {
            initDimensions();
            rocket.x = Math.random() * (canvas.width - 40) + 20;
            rocket.y = 20;
            rocket.vx = (Math.random() - 0.5) * 2;
            rocket.vy = 0.5;
            gameState = 'PLAYING';
            document.getElementById('msg-screen').style.display = 'none';
        }

        function finishGame(title, desc, isSuccess) {
            gameState = 'END';
            document.getElementById('msg-title').innerText = title;
            document.getElementById('msg-title').style.color = isSuccess ? '#06d6a0' : '#e63946';
            document.getElementById('msg-desc').innerText = desc;
            document.getElementById('btn-start').innerText = "YENİDEN DENE";
            document.getElementById('msg-screen').style.display = 'flex';
        }

        // Buton Kontrolleri (Mobil Dokunmatik)
        document.getElementById('left-btn').addEventListener('touchstart', () => moveLeft = true);
        document.getElementById('left-btn').addEventListener('touchend', () => moveLeft = false);
        document.getElementById('right-btn').addEventListener('touchstart', () => moveRight = true);
        document.getElementById('right-btn').addEventListener('touchend', () => moveRight = false);

        // Bilgisayarda Denenirse Diye Fare Desteği
        document.getElementById('left-btn').addEventListener('mousedown', () => moveLeft = true);
        document.getElementById('left-btn').addEventListener('mouseup', () => moveLeft = false);
        document.getElementById('right-btn').addEventListener('mousedown', () => moveRight = true);
        document.getElementById('right-btn').addEventListener('mouseup', () => moveRight = false);

        function loop() {
            if (gameState === 'PLAYING') {
                // Halat Hareketi
                if (moveLeft) platform.netX -= 4;
                if (moveRight) platform.netX += 4;

                // Sınırlar
                if (platform.netX < platform.x - 45) platform.netX = platform.x - 45;
                if (platform.netX > platform.x + 45) platform.netX = platform.x + 45;

                // Fizik
                rocket.vy += 0.08; // Yerçekimi

                // Otomatik Ters İtiş Freni
                let distance = (platform.y - 25) - (rocket.y + rocket.height);
                if (distance < 120 && rocket.vy > 2.0) {
                    rocket.vy -= 0.18;
                    rocket.isThrusting = true;
                } else {
                    rocket.isThrusting = false;
                }

                rocket.x += rocket.vx;
                rocket.y += rocket.vy;

                // Duvar sekmesi
                if (rocket.x < 10 || rocket.x > canvas.width - 10) rocket.vx *= -1;

                // İniş kontrolü
                let netTop = platform.y - 25;
                if (rocket.y + rocket.height >= netTop && rocket.y <= platform.y) {
                    if (rocket.x >= platform.netX - 20 && rocket.x <= platform.netX + 20) {
                        if (rocket.vy <= 2.2) {
                            finishGame("BAŞARILI!", "Roketi halatlarla güvenle yakaladın!", true);
                        } else {
                            finishGame("PATLAMA!", "Çok hızlı indiğin için roket çakıldı.", false);
                        }
                    }
                }

                // Iskalama
                if (rocket.y + rocket.height > platform.y + 10) {
                    finishGame("ISKADAN DENİZE!", "Halatları roketin altına yetiştiremedin.", false);
                }
            }

            // Çizim İşlemleri
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Deniz ve Hava Ayrımı
            ctx.fillStyle = '#1d3557';
            ctx.fillRect(0, platform.y, canvas.width, canvas.height - platform.y);

            // Gemi Tabanı
            ctx.fillStyle = '#4a5759';
            ctx.fillRect(platform.x - 55, platform.y - 5, 110, 10);

            // Yakalama Halat Direkleri
            ctx.strokeStyle = '#8d99ae';
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(platform.netX - 20, platform.y); ctx.lineTo(platform.netX - 20, platform.y - 30);
            ctx.moveTo(platform.netX + 20, platform.y); ctx.lineTo(platform.netX + 20, platform.y - 30);
            ctx.stroke();

            // Halat Çizgileri
            ctx.strokeStyle = '#d8f3dc';
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(platform.netX - 20, platform.y - 20); ctx.lineTo(platform.netX + 20, platform.y - 20);
            ctx.moveTo(platform.netX - 20, platform.y - 10); ctx.lineTo(platform.netX + 20, platform.y - 10);
            ctx.stroke();

            // Roket Çizimi
            if (gameState === 'PLAYING') {
                ctx.fillStyle = '#e5e5e5';
                ctx.fillRect(rocket.x - 6, rocket.y, rocket.width, rocket.height);

                // Roket Ucu
                ctx.fillStyle = '#118ab2';
                ctx.beginPath();
                ctx.moveTo(rocket.x - 6, rocket.y); ctx.lineTo(rocket.x, rocket.y - 10); ctx.lineTo(rocket.x + 6, rocket.y);
                ctx.fill();

                // Ateş Animasyonu
                if (rocket.isThrusting) {
                    ctx.fillStyle = '#ffb703';
                    ctx.beginPath();
                    ctx.moveTo(rocket.x - 4, rocket.y + rocket.height);
                    ctx.lineTo(rocket.x, rocket.y + rocket.height + 15);
                    ctx.lineTo(rocket.x + 4, rocket.y + rocket.height);
                    ctx.fill();
                }
            }

            requestAnimationFrame(loop);
        }

        requestAnimationFrame(loop);
    </script>
</body>
</html>
